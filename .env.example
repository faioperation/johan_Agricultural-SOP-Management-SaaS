# ==============================================================================
# Agricultural SOP Management SaaS - Environment Variables Template
# ==============================================================================

# --- Application ---
PORT=8000
NODE_ENV=development # Options: development, production, test
FRONT_END_URL=http://localhost:3000

# --- JWT Configuration ---
JWT_SECRET_TOKEN=generate_a_long_secure_random_string_here
JWT_REFRESH_TOKEN=generate_another_long_secure_random_string_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUND=10

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=sop_management
DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/sop_management

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_secure_redis_password

# --- SMTP Email Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=example@gmail.com
SMTP_PASS=app_specific_password_here
SMTP_FROM=example@gmail.com

# --- AI Service Integration ---
AI_BASE_URL=http://localhost:8080

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google OAuth ---
GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
